{
  "name": "@hidden-village/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:prod": "drizzle-kit migrate 2>&1",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio --config drizzle.config.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "latest",
    "drizzle-zod": "^0.8.3",
    "postgres": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "drizzle-kit": "latest",
    "typescript": "latest",
    "vitest": "4.1.5"
  }
}
