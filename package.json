{
  "name": "bank-data",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "scripts": {
    "dev": "pnpm dev:infra && pnpm dev:mcp",
    "dev:infra": "docker compose up -d postgres",
    "dev:mcp": "dotenv -e .env -- tsx src/mcp/index.ts",
    "build": "pnpm build:server",
    "build:server": "tsup",
    "start:mcp": "node dist/mcp.js",
    "start:mcp:local": "dotenv -e .env -- node dist/mcp.js",
    "start:sync": "node dist/sync.js",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "dotenv -e .env -- drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:studio": "dotenv -e .env -- drizzle-kit studio --config drizzle.config.ts",
    "test:smoke": "node scripts/smoke-server.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-dropzone": "^5.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "jsdom": "^28.1.0",
    "railway": "3.12.0",
    "tsup": "^8.5.1",
    "tsx": "4.22.0",
    "typescript": "6.0.3",
    "vite": "^8.0.0",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ],
    "overrides": {
      "@opentelemetry/api": "1.9.1",
      "typescript": "6.0.3"
    }
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.37",
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/s3-request-presigner": "3.1045.0",
    "@better-auth/drizzle-adapter": "1.6.25",
    "@fontsource-variable/noto-sans": "^5.2.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.3",
    "@tanstack/react-pacer": "0.22.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-router-devtools": "1.166.13",
    "@tanstack/react-router-ssr-query": "1.166.12",
    "@tanstack/react-start": "1.167.65",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "1.167.32",
    "ai": "^6.0.182",
    "better-auth": "1.6.25",
    "bullmq": "^5.76.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fflate": "^0.8.3",
    "googleapis": "^171.4.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.545.0",
    "nanoid": "^5.1.11",
    "nitro": "npm:nitro-nightly@3.0.1-20260501-164602-aee73f19",
    "pdf-to-img": "^6.2.0",
    "postgres": "latest",
    "pushmodal": "^1.0.5",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "react-pdf": "^10.4.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "imports": {
    "#banking": "./src/banking/index.ts",
    "#db": "./src/db/index.ts",
    "#db/schema": "./src/db/schema.ts",
    "#finance": "./src/finance/index.ts",
    "#storage": "./src/storage/index.ts"
  },
  "bin": {
    "bank-data-mcp": "./dist/mcp.js"
  }
}
