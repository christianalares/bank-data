DATABASE_URL=postgres://bank_data:bank_data@localhost:5433/bank_data
DATABASE_STATEMENT_TIMEOUT_MS=25000

# Generate with: openssl rand -hex 32. Existing data requires its original key.
PERSONAL_DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# Transport defaults to stdio, or HTTP when PORT is set.
# MCP_TRANSPORT=http
# PORT=3001
# HTTP credentials must be distinct, random values of at least 32 characters.
MCP_API_TOKEN=replace-with-at-least-32-random-characters
MCP_ALL_BANKS_TOKEN=
MCP_BOOKKEEPING_TOKEN=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_MAX_CONCURRENT_REQUESTS=4

# Enable Banking provider credentials for consent and synchronization.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_BASE64=

# Existing workspace UUIDs. Bookkeeping also uses the business workspace ID.
BANK_CONSENT_BUSINESS_WORKSPACE_ID=
BANK_CONSENT_PERSONAL_WORKSPACE_ID=
BANK_CONSENT_MCP_TOKEN=
# A separate random value of at least 32 characters.
BANK_CONSENT_COOKIE_SECRET=
BANK_CONSENT_REDIRECT_ORIGIN=http://localhost:3001
